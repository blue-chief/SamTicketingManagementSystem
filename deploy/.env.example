# ====================================================
# SamConsultingFirm Ticketing – Environment Variables
# Copy to .env and fill in real values for deployment.
# See docs/spec/M08-security-and-config.md Appendix B.
# ====================================================

# --- Database & infrastructure ---
DATABASE_URL=postgresql+asyncpg://sam:sam@postgres:5432/ticketing
REDIS_URL=redis://redis:6379/0
JWT_SECRET=CHANGE_ME_IN_PRODUCTION
APP_BASE_URL=http://localhost:8000

# --- IMAP (inbound email) ---
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_POLL_SECONDS=30

# --- SMTP (outbound email) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- SMS ---
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=

# --- WhatsApp ---
WHATSAPP_API_KEY=
WHATSAPP_PHONE_ID=

# --- AI / Analysis ---
AI_BACKEND=baseline
CONFIDENCE_THRESHOLD=0.60
DUPLICATE_SIMILARITY=0.92
SIMILAR_LINK_SIMILARITY=0.80

# --- Ticket lifecycle ---
ACK_TIMEOUT_MINUTES=10
MAX_AUTO_REASSIGN=2
MAX_ATTACHMENT_MB=10
AUTO_CLOSE_DAYS=3
REOPEN_WINDOW_DAYS=14

# --- Operations ---
BACKUP_RETENTION_DAYS=30
